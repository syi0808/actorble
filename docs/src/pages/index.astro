---
import {
  Apple,
  AppWindowMac,
  ArrowLeft,
  ArrowRight,
  BatteryFull,
  Circle,
  CircleCheck,
  CircleUserRound,
  Folder,
  Globe,
  NotebookTabs,
  RotateCw,
  Wifi,
} from '@lucide/astro'
import ActorbleSymbol from '../components/ActorbleSymbol.astro'

const base = import.meta.env.BASE_URL
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`
const browserDocs = withBase('docs/browser/')
const examples = withBase('docs/browser/examples/')
const github = 'https://github.com/syi0808/actorble'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Actorble is a scenario-based UI controller for visible, human-like browser interactions."
    />
    <title>Actorble | Visible UI scenario control</title>
  </head>
  <body>
    <header class="topbar" aria-label="Primary navigation">
      <a class="brand" href={withBase('')} aria-label="Actorble home">
        <ActorbleSymbol class="brand-wordmark" variant="wordmark" />
      </a>
      <nav class="nav">
        <a href="#demo">Demo</a>
        <a href={browserDocs}>Docs</a>
        <a href={github}>GitHub</a>
      </nav>
    </header>

    <main>
      <section
        class="cinematic-hero"
        id="demo"
        data-landing-demo
        data-scene="ready"
        data-actorble="closed"
        data-browser="closed"
        data-cursor="idle"
        data-nested="idle"
        data-request="idle"
        data-review="idle"
        aria-labelledby="hero-title"
      >
        <p class="sr-only" id="landing-demo-status" aria-live="polite">Demo ready</p>

        <div class="demo-theater" aria-label="Actorble cinematic nested browser demo">
          <div class="desktop-stage">
            <div class="mac-menu" aria-label="macOS menu bar">
              <div class="mac-menu-left">
                <Apple class="apple-mark" aria-hidden="true" />
                <strong>Actorble</strong>
                <span>File</span>
                <span>Edit</span>
                <span>View</span>
                <span>Window</span>
              </div>
              <div class="mac-menu-right">
                <Wifi class="menu-status-icon" aria-hidden="true" />
                <span class="battery-status">
                  <BatteryFull class="menu-status-icon" aria-hidden="true" />
                  <span>100%</span>
                </span>
                <span>Sat 9:41</span>
              </div>
            </div>

            <div class="desktop-wallpaper" aria-hidden="true">
              <ActorbleSymbol class="wallpaper-mark" variant="motion" />
            </div>

            <section class="actorble-window" aria-label="Actorble macOS app window">
              <div class="mac-window-bar">
                <div class="window-dots" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <strong>Actorble</strong>
                <span>Local</span>
              </div>
              <div class="actorble-app-body">
                <ActorbleSymbol class="app-symbol" />
                <div class="app-copy">
                  <h2>Browser scenario</h2>
                  <p>Open Chrome and hand control to Browser Actorble.</p>
                </div>
                <button
                  class="run-browser-button"
                  type="button"
                  data-testid="landing-run-browser"
                  disabled
                >
                  Run browser scenario
                </button>
              </div>
            </section>

            <section class="chrome-window" aria-label="Chrome browser window">
              <div class="chrome-tab-strip">
                <div class="window-dots" aria-hidden="true">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
                <div class="chrome-tab active">
                  <span class="chrome-favicon" aria-hidden="true">
                    <Globe class="chrome-favicon-icon" />
                  </span>
                  <span>Actorble Browser</span>
                </div>
                <div class="chrome-tab muted">Launch review</div>
              </div>
              <div class="chrome-toolbar">
                <div class="chrome-controls" aria-hidden="true">
                  <ArrowLeft class="chrome-control" />
                  <ArrowRight class="chrome-control disabled" />
                  <RotateCw class="chrome-control" />
                </div>
                <div class="chrome-address">actorble.local/browser/nested-run</div>
                <div class="chrome-profile" aria-hidden="true">
                  <CircleUserRound class="chrome-profile-icon" />
                </div>
              </div>

              <div class="browser-runtime">
                <aside class="runtime-panel" aria-label="Browser Actorble runner">
                  <ActorbleSymbol class="runtime-symbol" />
                  <h2>Browser Actorble</h2>
                  <p>Controls the page inside Chrome.</p>
                  <button
                    class="nested-run-button"
                    type="button"
                    data-testid="landing-start-nested"
                    disabled
                  >
                    Run nested scenario
                  </button>
                </aside>

                <section class="target-app" aria-label="Nested launch review app">
                  <div class="target-header">
                    <div>
                      <span class="target-eyebrow">Launch review</span>
                      <h2>Review workspace</h2>
                    </div>
                    <span class="review-badge" id="landing-review-badge">Waiting</span>
                  </div>

                  <div class="target-grid">
                    <section class="request-list" aria-label="Requests">
                      <button
                        class="request-card active"
                        type="button"
                        data-testid="landing-open-request"
                        disabled
                      >
                        <span>Maya Chen</span>
                        <strong>Prepare release review</strong>
                        <em>Confirm owner, scope, and readiness.</em>
                      </button>
                      <button class="request-card muted" type="button" disabled>
                        <span>Ops</span>
                        <strong>Update rollout notes</strong>
                        <em>Waiting for the final review.</em>
                      </button>
                    </section>

                    <section class="review-form" aria-label="Review form">
                      <label class="field">
                        <span>Review title</span>
                        <input
                          id="landing-review-title"
                          data-testid="landing-review-title"
                          autocomplete="off"
                          placeholder="Release review"
                          disabled
                        />
                      </label>

                      <label class="field">
                        <span>Owner</span>
                        <input
                          id="landing-review-owner"
                          data-testid="landing-review-owner"
                          autocomplete="off"
                          placeholder="maya@northstar.design"
                          disabled
                        />
                      </label>

                      <button
                        class="check-button"
                        type="button"
                        data-testid="landing-confirm-scope"
                        data-state="idle"
                        disabled
                      >
                        Scope confirmed
                      </button>

                      <button
                        class="review-button"
                        type="button"
                        data-testid="landing-mark-ready"
                        disabled
                      >
                        Mark review ready
                      </button>

                      <div
                        class="review-confirmation"
                        id="landing-review-confirmation"
                        data-state="idle"
                        aria-live="polite"
                      >
                        <Circle class="review-state-icon review-state-idle" aria-hidden="true" />
                        <CircleCheck
                          class="review-state-icon review-state-ready"
                          aria-hidden="true"
                        />
                        <p>Review waiting</p>
                      </div>
                    </section>
                  </div>
                </section>
              </div>
            </section>

            <div class="dock" aria-label="macOS Dock">
              <span class="dock-icon finder" aria-hidden="true">
                <Folder class="dock-lucide finder-icon" />
              </span>
              <button
                class="dock-icon actorble"
                type="button"
                data-testid="landing-dock-actorble"
                aria-label="Open Actorble"
              >
                <ActorbleSymbol class="dock-symbol" />
              </button>
              <span class="dock-icon browser" aria-hidden="true">
                <AppWindowMac class="dock-lucide browser-icon" />
              </span>
              <span class="dock-icon notes" aria-hidden="true">
                <NotebookTabs class="dock-lucide notes-icon" />
              </span>
            </div>
          </div>

          <div class="hero-reveal">
            <h1 id="hero-title">Choreograph UI scenarios you can watch.</h1>
            <p>
              Actorble opens the browser, hands off to Browser Actorble, and runs
              the next scenario inside the page.
            </p>
            <div class="hero-actions">
              <button class="button primary" type="button" data-demo-run>
                Watch again
              </button>
              <a class="button secondary" href={browserDocs}>Read browser docs</a>
              <a class="button ghost" href={github}>Open GitHub</a>
            </div>
          </div>

          <div class="start-panel">
            <button class="button primary" type="button" data-demo-run>
              Watch the demo
            </button>
          </div>
        </div>
      </section>

      <section class="section intro-section" aria-labelledby="intro-title">
        <div class="section-heading">
          <h2 id="intro-title">A scenario is more than a command.</h2>
          <p>
            Actorble resolves the target, moves through the interface, performs the
            action, waits for the UI to settle, and keeps the run repeatable.
          </p>
        </div>
        <div class="feature-grid">
          <article>
            <h3>Visible by default</h3>
            <p>Interactions happen on the page, so people can understand the run without extra explanation.</p>
          </article>
          <article>
            <h3>Built for pacing</h3>
            <p>Clicks, typing, waits, and pauses are part of the scenario instead of scattered timers.</p>
          </article>
          <article>
            <h3>Browser first</h3>
            <p>The browser package is active now, with the same scenario shape ready for future surfaces.</p>
          </article>
        </div>
      </section>

      <section class="section surfaces" aria-labelledby="surfaces-title">
        <div class="section-heading">
          <h2 id="surfaces-title">Use it in the browser today.</h2>
          <p>
            The current package focuses on target resolution, synthetic input, visual
            feedback, scenario running, and interface settlement.
          </p>
        </div>
        <div class="surface-grid">
          <article class="surface-card active">
            <h3>Browser</h3>
            <p>Available now for visible UI scenarios in web interfaces.</p>
          </article>
          <article class="surface-card">
            <h3>macOS</h3>
            <p>Planned native surface using the same scenario contract.</p>
          </article>
          <article class="surface-card">
            <h3>Windows</h3>
            <p>Planned desktop engine for application workflows.</p>
          </article>
          <article class="surface-card">
            <h3>Linux</h3>
            <p>Planned automation surface outside the browser sandbox.</p>
          </article>
        </div>
      </section>

      <section class="section final-cta" aria-labelledby="cta-title">
        <h2 id="cta-title">Run a scenario people can actually follow.</h2>
        <div class="hero-actions">
          <button class="button primary" type="button" data-demo-run>
            Watch the demo
          </button>
          <a class="button secondary" href={examples}>See examples</a>
          <a class="button ghost" href={github}>Open GitHub</a>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  import {
    createActorble,
    testId,
    type Actorble,
    type Scenario,
  } from '@actorble/browser-source'

  type DemoScene =
    | 'ready'
    | 'actorble-app'
    | 'browser-open'
    | 'nested-running'
    | 'complete'
    | 'failed'

  const demoRoot = document.querySelector<HTMLElement>('[data-landing-demo]')

  if (demoRoot) {
    const activeDemoRoot = demoRoot
    const runButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo-run]'))
    const statusOutput = document.getElementById('landing-demo-status')
    const dockActorble = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-dock-actorble"]',
    )
    const runBrowserButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-run-browser"]',
    )
    const startNestedButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-start-nested"]',
    )
    const requestButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-open-request"]',
    )
    const titleInput = document.getElementById('landing-review-title') as HTMLInputElement | null
    const ownerInput = document.getElementById('landing-review-owner') as HTMLInputElement | null
    const checkButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-confirm-scope"]',
    )
    const reviewButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-mark-ready"]',
    )
    const reviewBadge = document.getElementById('landing-review-badge')
    const confirmation = document.getElementById('landing-review-confirmation') as HTMLElement | null
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const canAutoPlay = !reduceMotion && window.matchMedia('(min-width: 900px)').matches

    let running = false
    let runCount = 0

    dockActorble?.addEventListener('click', openActorbleApp)
    runBrowserButton?.addEventListener('click', openBrowserActorble)
    startNestedButton?.addEventListener('click', startNestedRun)
    requestButton?.addEventListener('click', openRequest)
    titleInput?.addEventListener('input', updateReviewAvailability)
    titleInput?.addEventListener('click', () => {
      titleInput.focus({ preventScroll: true })
    })
    ownerInput?.addEventListener('input', updateReviewAvailability)
    ownerInput?.addEventListener('click', () => {
      ownerInput.focus({ preventScroll: true })
    })
    checkButton?.addEventListener('click', confirmScope)
    reviewButton?.addEventListener('click', markReviewReady)

    for (const button of runButtons) {
      button.addEventListener('click', () => {
        void runDemo()
      })
    }

    resetDemo()

    if (canAutoPlay) {
      window.setTimeout(() => {
        void runDemo()
      }, 900)
    }

    async function runDemo() {
      if (running) {
        return
      }

      running = true
      runCount += 1
      setRunButtonsDisabled(true)
      resetDemo()
      window.scrollTo({ top: activeDemoRoot.offsetTop, behavior: 'auto' })

      try {
        await wait(420)
        const outer = createDemoActorble()
        setCursorSurface('mac')

        try {
          await outer.click(testId('landing-dock-actorble'), createClickOptions(1500))
          await wait(820)
          await outer.click(testId('landing-run-browser'), createClickOptions(1580))
          await wait(920)
          await outer.click(testId('landing-start-nested'), createClickOptions(1500))
        } finally {
          await wait(460)
          outer.destroy()
        }

        const inner = createDemoActorble()
        setCursorSurface('browser')

        try {
          await inner.run(buildNestedScenario(runCount), {
            timeout: 48000,
            pacing: { betweenSteps: 760 },
          })
        } finally {
          await wait(620)
          inner.destroy()
        }

        setDemoScene('complete', 'Nested browser scenario complete')
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error)
        setDemoScene('failed', `Demo stopped: ${message}`)
      } finally {
        setCursorSurface('idle')
        setRunButtonsDisabled(false)
        running = false
      }
    }

    function createDemoActorble(): Actorble {
      return createActorble({
        mode: 'interactive',
        visual: {
          preset: 'quiet',
          cursorScale: 2.6,
          cursor: true,
          targetHighlight: false,
          clickFeedback: false,
          focusOverlay: false,
          typingIndicator: false,
          keystrokeOverlay: false,
          textVisibility: 'hidden',
        },
      })
    }

    function buildNestedScenario(index: number): Scenario {
      const owner = index % 2 === 0 ? 'maya@northstar.design' : 'maya.chen@northstar.design'

      return {
        id: 'landing-nested-browser-demo',
        name: 'Landing nested browser demo',
        steps: [
          {
            action: 'click',
            target: testId('landing-open-request'),
            options: createClickOptions(1480),
          },
          {
            action: 'delay',
            duration: 760,
            reason: 'Let the request open',
          },
          {
            action: 'typeInto',
            target: testId('landing-review-title'),
            input: 'Release review',
            options: createTypeOptions(),
          },
          {
            action: 'delay',
            duration: 680,
            reason: 'Hold the typed title',
          },
          {
            action: 'typeInto',
            target: testId('landing-review-owner'),
            input: owner,
            options: createTypeOptions(),
          },
          {
            action: 'delay',
            duration: 720,
            reason: 'Hold the owner field',
          },
          {
            action: 'click',
            target: testId('landing-confirm-scope'),
            options: createClickOptions(1400),
          },
          {
            action: 'delay',
            duration: 820,
            reason: 'Show scope confirmation',
          },
          {
            action: 'click',
            target: testId('landing-mark-ready'),
            options: createClickOptions(1460),
          },
          {
            action: 'waitFor',
            input: {
              kind: 'custom',
              predicate: () => activeDemoRoot.dataset.review === 'ready',
            },
            options: { timeout: 3600 },
          },
        ],
      }
    }

    function resetDemo() {
      setDemoScene('ready', 'Demo ready')
      activeDemoRoot.dataset.actorble = 'closed'
      activeDemoRoot.dataset.browser = 'closed'
      activeDemoRoot.dataset.cursor = 'idle'
      activeDemoRoot.dataset.nested = 'idle'
      activeDemoRoot.dataset.request = 'idle'
      activeDemoRoot.dataset.review = 'idle'
      document.documentElement.dataset.actorbleCursor = 'idle'

      if (runBrowserButton) {
        runBrowserButton.disabled = true
      }

      if (startNestedButton) {
        startNestedButton.disabled = true
      }

      if (requestButton) {
        requestButton.disabled = true
      }

      if (titleInput) {
        titleInput.value = ''
        titleInput.disabled = true
      }

      if (ownerInput) {
        ownerInput.value = ''
        ownerInput.disabled = true
      }

      if (checkButton) {
        checkButton.disabled = true
        checkButton.dataset.state = 'idle'
      }

      if (reviewButton) {
        reviewButton.disabled = true
      }

      if (reviewBadge) {
        reviewBadge.textContent = 'Waiting'
      }

      if (confirmation) {
        confirmation.dataset.state = 'idle'
        const text = confirmation.querySelector('p')
        if (text) {
          text.textContent = 'Review waiting'
        }
      }
    }

    function openActorbleApp() {
      activeDemoRoot.dataset.actorble = 'open'
      setDemoScene('actorble-app', 'Actorble app opened')

      if (runBrowserButton) {
        runBrowserButton.disabled = false
      }
    }

    function openBrowserActorble() {
      activeDemoRoot.dataset.browser = 'open'
      setDemoScene('browser-open', 'Browser Actorble opened')

      if (startNestedButton) {
        startNestedButton.disabled = false
      }
    }

    function startNestedRun() {
      activeDemoRoot.dataset.nested = 'running'
      setDemoScene('nested-running', 'Nested browser scenario running')

      if (requestButton) {
        requestButton.disabled = false
      }

      if (reviewBadge) {
        reviewBadge.textContent = 'Running'
      }
    }

    function openRequest() {
      activeDemoRoot.dataset.request = 'open'

      if (titleInput) {
        titleInput.disabled = false
      }

      if (ownerInput) {
        ownerInput.disabled = false
      }

      if (checkButton) {
        checkButton.disabled = false
      }
    }

    function confirmScope() {
      if (checkButton) {
        checkButton.dataset.state = 'confirmed'
      }

      updateReviewAvailability()
    }

    function markReviewReady() {
      activeDemoRoot.dataset.review = 'ready'

      if (reviewBadge) {
        reviewBadge.textContent = 'Review ready'
      }

      if (confirmation) {
        confirmation.dataset.state = 'ready'
        const text = confirmation.querySelector('p')
        if (text) {
          text.textContent = 'Review ready'
        }
      }
    }

    function updateReviewAvailability() {
      if (!reviewButton) {
        return
      }

      const hasTitle = titleInput instanceof HTMLInputElement && titleInput.value.trim().length > 0
      const hasOwner = ownerInput instanceof HTMLInputElement && ownerInput.value.trim().length > 0
      const hasScope = checkButton?.dataset.state === 'confirmed'

      reviewButton.disabled = !(hasTitle && hasOwner && hasScope)
    }

    function setDemoScene(scene: DemoScene, label: string): void {
      activeDemoRoot.dataset.scene = scene

      if (statusOutput) {
        statusOutput.textContent = label
      }
    }

    function setCursorSurface(surface: 'idle' | 'mac' | 'browser'): void {
      activeDemoRoot.dataset.cursor = surface
      document.documentElement.dataset.actorbleCursor = surface
    }

    function createClickOptions(duration: number) {
      return {
        ...revealNearest(),
        motion: { kind: 'ease' as const, easing: 'ease-in-out' as const, duration },
        pressDwell: 240,
        timeout: 6800,
      }
    }

    function createTypeOptions() {
      return {
        ...revealNearest(),
        delay: 112,
        focusClick: createClickOptions(1420),
        focusStrategy: 'click' as const,
        afterFocusDelay: 260,
        timeout: 9800,
      }
    }

    function setRunButtonsDisabled(disabled: boolean): void {
      for (const button of runButtons) {
        button.disabled = disabled
      }
    }

    function revealNearest() {
      return {
        block: 'nearest' as ScrollLogicalPosition,
        inline: 'nearest' as ScrollLogicalPosition,
      }
    }

    function wait(duration: number): Promise<void> {
      return new Promise((resolve) => {
        window.setTimeout(resolve, duration)
      })
    }
  }
</script>

<style>
  :root {
    color-scheme: dark;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #080b0f;
    color: #f7fbff;
    letter-spacing: 0;
    --ink: #080b0f;
    --panel: #101820;
    --panel-2: #16222c;
    --line: rgba(215, 224, 231, 0.16);
    --muted: #99a9b5;
    --soft: #d7e0e7;
    --mint: #33e6c2;
    --mint-dark: #087f70;
    --amber: #f2b84b;
    --coral: #ff6b5f;
    --blue: #5aa8ff;
    --white: #ffffff;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-padding-top: 92px;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      linear-gradient(rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.024) 1px, transparent 1px),
      #080b0f;
    background-size: 36px 36px;
    color: var(--white);
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(130deg, rgba(51, 230, 194, 0.13), transparent 42%),
      linear-gradient(310deg, rgba(90, 168, 255, 0.12), transparent 38%),
      linear-gradient(180deg, #0c1116 0%, #080b0f 56%, #111820 100%);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
    letter-spacing: 0;
  }

  button {
    cursor: pointer;
  }

  button:disabled {
    cursor: wait;
  }

  h1,
  h2,
  h3,
  p {
    letter-spacing: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding: 0 clamp(18px, 5vw, 72px);
    border-bottom: 1px solid rgba(215, 224, 231, 0.12);
    background: rgba(8, 11, 15, 0.72);
    backdrop-filter: blur(18px);
  }

  .brand,
  .nav,
  .hero-actions,
  .mac-menu,
  .mac-menu-left,
  .mac-menu-right,
  .window-dots,
  .mac-window-bar,
  .chrome-tab-strip,
  .chrome-tab,
  .chrome-toolbar,
  .chrome-controls,
  .dock,
  .review-confirmation {
    display: flex;
    align-items: center;
  }

  .brand {
    gap: 10px;
    font-weight: 800;
  }

  .brand-wordmark {
    width: 112px;
    height: auto;
    overflow: visible;
  }

  .brand-wordmark .actorble-wordmark-letter {
    fill: var(--white);
  }

  .nav {
    gap: clamp(14px, 3vw, 24px);
    color: #c7d2da;
    font-size: 0.94rem;
  }

  .nav a:hover {
    color: var(--mint);
  }

  .cinematic-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
  }

  .demo-theater {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 74px 14px 14px;
    perspective: 1800px;
  }

  .desktop-stage {
    position: relative;
    width: min(1560px, calc(100vw - 28px));
    height: min(900px, calc(100svh - 88px));
    min-height: 620px;
    overflow: hidden;
    border: 1px solid rgba(215, 224, 231, 0.18);
    border-radius: 8px;
    background:
      linear-gradient(135deg, #25445e 0%, #1d676c 35%, #172b42 68%, #11151f 100%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 18px);
    box-shadow:
      0 44px 120px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    transform: translateY(0) scale(1);
    transform-origin: center 44%;
    transition:
      opacity 900ms ease,
      filter 900ms ease,
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cinematic-hero[data-scene="complete"] .desktop-stage {
    opacity: 0.68;
    filter: brightness(0.72) saturate(0.9);
    transform: translateY(-10vh) scale(0.78) rotateX(4deg);
  }

  .mac-menu {
    position: relative;
    z-index: 10;
    justify-content: space-between;
    gap: 14px;
    height: 30px;
    padding: 0 14px;
    background: rgba(248, 250, 252, 0.74);
    color: #17202a;
    font-size: 0.78rem;
    font-weight: 730;
    backdrop-filter: blur(18px);
  }

  .mac-menu-left,
  .mac-menu-right {
    gap: 14px;
    min-width: 0;
  }

  .mac-menu-right {
    justify-content: flex-end;
  }

  .battery-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .menu-status-icon {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    stroke-width: 2.2;
  }

  .apple-mark {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    fill: #17202a;
    stroke-width: 1.8;
  }

  .desktop-wallpaper {
    position: absolute;
    inset: 58px 36px 88px;
    pointer-events: none;
  }

  .wallpaper-mark {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .wallpaper-mark .actorble-motion-rail,
  .wallpaper-mark .actorble-motion-cross-rail {
    opacity: 0.22;
  }

  .wallpaper-mark .actorble-motion-path {
    opacity: 0.18;
    stroke: rgba(51, 230, 194, 0.22);
  }

  .wallpaper-mark .actorble-motion-cross {
    opacity: 0.25;
    stroke: rgba(242, 184, 75, 0.28);
  }

  .actorble-window,
  .chrome-window {
    position: absolute;
    z-index: 4;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 8px;
    box-shadow: 0 32px 90px rgba(0, 0, 0, 0.34);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 480ms ease,
      transform 620ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 360ms ease;
  }

  .actorble-window {
    top: 74px;
    left: clamp(22px, 4vw, 58px);
    width: min(430px, 36vw);
    background: rgba(15, 22, 32, 0.92);
    color: var(--white);
    backdrop-filter: blur(20px);
    transform: translateY(18px) scale(0.98);
  }

  .chrome-window {
    top: clamp(74px, 11vh, 104px);
    right: clamp(22px, 4vw, 58px);
    bottom: 86px;
    width: min(930px, 68vw);
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    background: #f5f7fb;
    color: #17202a;
    transform: translateY(24px) scale(0.975);
  }

  .cinematic-hero[data-actorble="open"] .actorble-window,
  .cinematic-hero[data-browser="open"] .actorble-window,
  .cinematic-hero[data-nested="running"] .actorble-window,
  .cinematic-hero[data-scene="complete"] .actorble-window {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .cinematic-hero[data-browser="open"] .chrome-window,
  .cinematic-hero[data-nested="running"] .chrome-window,
  .cinematic-hero[data-scene="complete"] .chrome-window {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .cinematic-hero[data-nested="running"] .chrome-window,
  .cinematic-hero[data-scene="complete"] .chrome-window {
    box-shadow:
      0 0 0 1px rgba(51, 230, 194, 0.18),
      0 36px 98px rgba(0, 0, 0, 0.4);
  }

  .mac-window-bar {
    justify-content: space-between;
    gap: 12px;
    min-height: 38px;
    padding: 0 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.08);
  }

  .mac-window-bar strong,
  .mac-window-bar span:last-child {
    font-size: 0.86rem;
  }

  .mac-window-bar span:last-child {
    color: #cbd8e2;
  }

  .window-dots {
    gap: 7px;
  }

  .window-dots span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--coral);
  }

  .window-dots span:nth-child(2) {
    background: var(--amber);
  }

  .window-dots span:nth-child(3) {
    background: var(--mint);
  }

  .actorble-app-body {
    display: grid;
    gap: 16px;
    padding: 20px;
  }

  .app-symbol,
  .runtime-symbol,
  .dock-symbol {
    overflow: visible;
  }

  .app-symbol {
    width: 46px;
    height: 46px;
  }

  .app-copy h2,
  .runtime-panel h2,
  .target-header h2 {
    margin: 0;
    color: inherit;
    line-height: 1.08;
  }

  .app-copy h2 {
    font-size: 1.45rem;
  }

  .app-copy p,
  .runtime-panel p {
    margin: 8px 0 0;
    color: #b8c7d3;
    font-size: 0.94rem;
    line-height: 1.48;
  }

  .run-browser-button,
  .nested-run-button,
  .request-card,
  .check-button,
  .review-button {
    border-radius: 8px;
    font-weight: 850;
    scroll-margin: 150px 0;
  }

  .run-browser-button,
  .nested-run-button,
  .review-button {
    min-height: 44px;
    border: 0;
    padding: 0 16px;
  }

  .run-browser-button {
    justify-self: start;
    background: var(--amber);
    color: #241700;
  }

  .chrome-tab-strip {
    gap: 9px;
    min-height: 40px;
    padding: 0 12px;
    background: #dfe5ec;
  }

  .chrome-tab {
    gap: 8px;
    min-width: 154px;
    height: 30px;
    border-radius: 8px 8px 0 0;
    padding: 0 12px;
    background: #f5f7fb;
    color: #1b2733;
    font-size: 0.82rem;
    font-weight: 760;
  }

  .chrome-tab.muted {
    background: rgba(255, 255, 255, 0.38);
    color: #607080;
  }

  .chrome-favicon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #e8f1ff;
    color: #2563eb;
  }

  .chrome-favicon-icon {
    width: 12px;
    height: 12px;
    stroke-width: 2.4;
  }

  .chrome-toolbar {
    gap: 10px;
    min-height: 42px;
    padding: 0 12px;
    border-bottom: 1px solid rgba(16, 20, 24, 0.1);
    background: #f3f6fa;
  }

  .chrome-controls {
    flex: 0 0 auto;
    gap: 7px;
    width: 62px;
  }

  .chrome-control {
    flex: 0 0 auto;
    width: 17px;
    height: 17px;
    color: #64748b;
    opacity: 0.92;
    stroke-width: 2.25;
  }

  .chrome-control.disabled {
    opacity: 0.48;
  }

  .chrome-address {
    flex: 1;
    min-width: 0;
    height: 30px;
    overflow: hidden;
    border: 1px solid #d2dbe3;
    border-radius: 999px;
    padding: 6px 14px;
    background: #ffffff;
    color: #536272;
    font-size: 0.82rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .chrome-profile {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: #1f2937;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 850;
  }

  .chrome-profile-icon {
    width: 18px;
    height: 18px;
    stroke-width: 2.2;
  }

  .browser-runtime {
    display: grid;
    grid-template-columns: minmax(190px, 0.33fr) minmax(430px, 1fr);
    min-height: 0;
    background: #f7f9fc;
  }

  .runtime-panel {
    display: grid;
    align-content: start;
    gap: 15px;
    padding: 24px;
    border-right: 1px solid #dde6ee;
    background: #111827;
    color: var(--white);
  }

  .runtime-symbol {
    width: 46px;
    height: 46px;
  }

  .runtime-panel h2 {
    font-size: 1.3rem;
  }

  .nested-run-button {
    justify-self: start;
    margin-top: 4px;
    background: var(--mint);
    color: #06201c;
  }

  .target-app {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    min-width: 0;
    background:
      linear-gradient(rgba(21, 32, 43, 0.035) 1px, transparent 1px),
      #f8fafc;
    background-size: 24px 24px;
  }

  .target-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 24px 16px;
    border-bottom: 1px solid #e2e8f0;
  }

  .target-eyebrow {
    color: #64748b;
    font-size: 0.84rem;
    font-weight: 850;
  }

  .target-header h2 {
    margin-top: 3px;
    color: #17202a;
    font-size: clamp(1.45rem, 2vw, 2rem);
  }

  .review-badge {
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    padding: 7px 12px;
    background: #ffffff;
    color: #64748b;
    font-size: 0.84rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .cinematic-hero[data-review="ready"] .review-badge {
    border-color: rgba(8, 127, 112, 0.3);
    background: rgba(51, 230, 194, 0.14);
    color: #065f55;
  }

  .target-grid {
    display: grid;
    grid-template-columns: minmax(210px, 0.4fr) minmax(300px, 1fr);
    gap: 18px;
    min-height: 0;
    padding: 22px 24px 24px;
  }

  .request-list {
    display: grid;
    align-content: start;
    gap: 12px;
    min-width: 0;
  }

  .request-card {
    display: grid;
    gap: 8px;
    min-height: 118px;
    border: 1px solid #d6e0ea;
    padding: 15px;
    background: #ffffff;
    color: #17202a;
    text-align: left;
  }

  .request-card.active {
    border-color: rgba(8, 127, 112, 0.3);
    box-shadow: 0 14px 30px rgba(16, 24, 40, 0.08);
  }

  .request-card.muted {
    opacity: 0.58;
  }

  .request-card span,
  .request-card em {
    color: #657586;
    font-size: 0.86rem;
    font-style: normal;
  }

  .request-card strong {
    font-size: 1rem;
  }

  .cinematic-hero[data-request="open"] .request-card.active {
    border-color: rgba(8, 127, 112, 0.5);
    transform: translateY(-2px);
  }

  .review-form {
    display: grid;
    align-content: start;
    gap: 13px;
    min-width: 0;
  }

  .field {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  .field span {
    color: #334155;
    font-size: 0.84rem;
    font-weight: 850;
  }

  .field input {
    width: 100%;
    min-width: 0;
    min-height: 46px;
    border: 1px solid #bac8d6;
    border-radius: 8px;
    padding: 0 13px;
    background: #ffffff;
    color: #111827;
    font-size: 0.96rem;
    scroll-margin: 150px 0;
  }

  .field input:disabled,
  .request-card:disabled,
  .check-button:disabled,
  .review-button:disabled,
  .nested-run-button:disabled,
  .run-browser-button:disabled {
    opacity: 0.58;
  }

  .field input:focus {
    outline: 3px solid rgba(51, 230, 194, 0.24);
    border-color: var(--mint-dark);
  }

  .check-button,
  .review-button {
    min-height: 44px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #17202a;
  }

  .check-button[data-state="confirmed"] {
    border-color: rgba(8, 127, 112, 0.36);
    background: rgba(51, 230, 194, 0.13);
    color: #065f55;
  }

  .review-button {
    justify-self: start;
    border: 0;
    padding: 0 16px;
    background: #101418;
    color: #ffffff;
  }

  .review-confirmation {
    gap: 10px;
    min-height: 50px;
    max-width: 360px;
    border: 1px solid #d6e0ea;
    border-radius: 8px;
    padding: 0 14px;
    background: #ffffff;
    color: #64748b;
  }

  .review-state-icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: #94a3b8;
    stroke-width: 2.35;
  }

  .review-state-ready {
    display: none;
  }

  .review-confirmation p {
    margin: 0;
    font-weight: 850;
  }

  .review-confirmation[data-state="ready"] {
    border-color: rgba(8, 127, 112, 0.32);
    background: rgba(51, 230, 194, 0.12);
    color: #065f55;
  }

  .review-confirmation[data-state="ready"] .review-state-idle {
    display: none;
  }

  .review-confirmation[data-state="ready"] .review-state-ready {
    display: block;
    color: #087f70;
  }

  .dock {
    position: absolute;
    z-index: 8;
    left: 50%;
    bottom: 16px;
    gap: 10px;
    min-height: 64px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 8px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
  }

  .dock-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 8px;
    padding: 0;
    background: rgba(255, 255, 255, 0.55);
    scroll-margin: 0;
  }

  .dock-symbol {
    width: 32px;
    height: 32px;
  }

  .dock-lucide {
    width: 27px;
    height: 27px;
    stroke-width: 2.15;
  }

  .dock-symbol .actorble-mark-base,
  .dock-symbol .actorble-mark-cross {
    fill: none;
  }

  .dock-symbol .actorble-mark-base {
    stroke: var(--mint-dark);
  }

  .dock-symbol .actorble-mark-rail,
  .dock-symbol .actorble-mark-cross-rail {
    stroke: rgba(255, 255, 255, 0.8);
  }

  .dock-symbol .actorble-mark-cross {
    stroke: #9a6400;
  }

  .dock-icon.finder {
    background: linear-gradient(135deg, #dff6ff, #ffffff 54%, #b8dcff);
    color: #1679ba;
  }

  .dock-icon.actorble {
    background: rgba(255, 255, 255, 0.7);
  }

  .dock-icon.browser {
    background: linear-gradient(135deg, #eef6ff, #ffffff 52%, #dbeafe);
    color: #2563eb;
  }

  .dock-icon.notes {
    background: linear-gradient(180deg, #fde68a 0 32%, #ffffff 33% 100%);
    color: #8a5b00;
  }

  .hero-reveal {
    position: absolute;
    z-index: 12;
    left: clamp(18px, 6vw, 96px);
    right: clamp(18px, 6vw, 96px);
    bottom: clamp(40px, 9vh, 94px);
    max-width: 760px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(26px);
    transition:
      opacity 760ms ease 260ms,
      transform 760ms cubic-bezier(0.16, 1, 0.3, 1) 260ms;
  }

  .cinematic-hero[data-scene="complete"] .hero-reveal {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .hero-reveal h1 {
    margin: 0;
    max-width: 760px;
    color: var(--white);
    font-size: clamp(3.3rem, 7.2vw, 7.4rem);
    line-height: 0.92;
    text-wrap: balance;
    text-shadow: 0 18px 44px rgba(0, 0, 0, 0.46);
  }

  .hero-reveal p {
    max-width: 660px;
    margin: 24px 0 0;
    color: #d7e0e7;
    font-size: clamp(1.04rem, 1.7vw, 1.26rem);
    line-height: 1.58;
    text-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }

  .hero-actions {
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0 18px;
    font-weight: 850;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button:disabled {
    opacity: 0.68;
    transform: none;
  }

  .primary {
    background: var(--mint);
    color: #06201c;
  }

  .secondary {
    border-color: rgba(215, 224, 231, 0.24);
    background: rgba(255, 255, 255, 0.09);
    color: var(--white);
  }

  .ghost {
    border-color: rgba(215, 224, 231, 0.16);
    color: #d7e0e7;
  }

  .start-panel {
    position: absolute;
    z-index: 14;
    right: clamp(18px, 6vw, 96px);
    bottom: clamp(32px, 7vh, 72px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 260ms ease;
  }

  .cinematic-hero[data-scene="ready"] .start-panel,
  .cinematic-hero[data-scene="failed"] .start-panel {
    opacity: 1;
    pointer-events: auto;
  }

  .cinematic-hero[data-scene="complete"] .start-panel {
    display: none;
  }

  :global([data-actorble-visual-cursor]) {
    z-index: 1000 !important;
    filter: drop-shadow(0 12px 20px rgba(0, 0, 0, 0.34)) !important;
    transition: filter 180ms ease, transform 80ms ease-out !important;
  }

  :global(:root[data-actorble-cursor="mac"] [data-actorble-visual-cursor]) {
    filter:
      drop-shadow(0 0 10px rgba(242, 184, 75, 0.58))
      drop-shadow(0 0 22px rgba(255, 255, 255, 0.22))
      drop-shadow(0 12px 20px rgba(0, 0, 0, 0.34)) !important;
  }

  :global(:root[data-actorble-cursor="browser"] [data-actorble-visual-cursor]) {
    filter:
      drop-shadow(0 0 10px rgba(51, 230, 194, 0.64))
      drop-shadow(0 0 24px rgba(90, 168, 255, 0.24))
      drop-shadow(0 12px 20px rgba(0, 0, 0, 0.34)) !important;
  }

  .section {
    padding: clamp(64px, 8vw, 108px) clamp(18px, 5vw, 72px);
  }

  .section-heading {
    max-width: 860px;
  }

  .section-heading p {
    color: #aebbc7;
    font-size: 1rem;
    line-height: 1.65;
  }

  .section h2 {
    margin: 0;
    color: var(--white);
    font-size: clamp(2rem, 4.6vw, 4.4rem);
    line-height: 1.03;
    text-wrap: balance;
  }

  .feature-grid,
  .surface-grid {
    display: grid;
    gap: 14px;
    margin-top: 34px;
  }

  .feature-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .surface-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .feature-grid article,
  .surface-card {
    min-height: 184px;
    border: 1px solid rgba(215, 224, 231, 0.14);
    border-radius: 8px;
    padding: 20px;
    background: rgba(255, 255, 255, 0.055);
  }

  .surface-card.active {
    border-color: rgba(51, 230, 194, 0.4);
    background: rgba(51, 230, 194, 0.08);
  }

  h3 {
    margin: 0;
    color: var(--white);
    font-size: 1.08rem;
  }

  article p {
    margin: 12px 0 0;
    color: #aebbc7;
    line-height: 1.56;
  }

  .surfaces {
    border-block: 1px solid rgba(215, 224, 231, 0.1);
    background: rgba(255, 255, 255, 0.035);
  }

  .final-cta {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  .final-cta .hero-actions {
    justify-content: center;
  }

  @media (max-width: 1180px) {
    .actorble-window {
      width: min(380px, 40vw);
    }

    .chrome-window {
      width: min(790px, 66vw);
    }

    .browser-runtime {
      grid-template-columns: 180px minmax(360px, 1fr);
    }

    .target-grid {
      grid-template-columns: 1fr;
      overflow: auto;
    }

    .request-card.muted {
      display: none;
    }

    .feature-grid,
    .surface-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .demo-theater {
      align-items: start;
      height: 100svh;
      min-height: 100svh;
      overflow: visible;
