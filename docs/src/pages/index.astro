---
const base = import.meta.env.BASE_URL
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`
const browserDocs = withBase('docs/browser/')
const gettingStarted = withBase('docs/browser/getting-started/')
const github = 'https://github.com/syi0808/actorble'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Actorble is a scenario-based UI control project for browser automation and future native platforms."
    />
    <title>Actorble</title>
  </head>
  <body>
    <header class="topbar" aria-label="Primary navigation">
      <a class="brand" href={withBase('')}>Actorble</a>
      <nav class="nav">
        <a href={browserDocs}>Docs</a>
        <a href={github}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="scene" aria-hidden="true">
          <div class="browser-shell">
            <div class="browser-bar">
              <span></span>
              <span></span>
              <span></span>
              <div class="address">actorble.run/scenario</div>
            </div>
            <div class="workspace">
              <div class="panel target-panel">
                <div class="label">Target surface</div>
                <div class="field">Project name</div>
                <div class="button-target">Create project</div>
              </div>
              <div class="panel trace-panel">
                <div class="label">Trace</div>
                <ol>
                  <li>resolve target</li>
                  <li>compute geometry</li>
                  <li>dispatch click</li>
                  <li>settle observation</li>
                </ol>
              </div>
              <div class="cursor"></div>
              <div class="path path-a"></div>
              <div class="path path-b"></div>
            </div>
          </div>
        </div>

        <div class="hero-copy">
          <p class="eyebrow">Browser first. Native platforms next.</p>
          <h1>Actorble</h1>
          <p class="lede">
            Scenario-based UI control for choreographing human-like interactions with
            explicit state, deterministic orchestration, and inspectable diagnostics.
          </p>
          <div class="actions">
            <a class="button primary" href={gettingStarted}>Get started</a>
            <a class="button secondary" href={browserDocs}>Browser docs</a>
          </div>
        </div>
      </section>

      <section class="section intro" aria-labelledby="intro-title">
        <div class="section-heading">
          <p class="eyebrow">Execution model</p>
          <h2 id="intro-title">Built around observable interaction state.</h2>
        </div>
        <div class="feature-grid">
          <article>
            <h3>Scenario runner</h3>
            <p>Runs ordered steps while preserving pause, resume, stop, timeout, and trace boundaries.</p>
          </article>
          <article>
            <h3>Action orchestrator</h3>
            <p>Turns high-level actions into resolve, preflight, input, wait, and cleanup transactions.</p>
          </article>
          <article>
            <h3>Browser fidelity</h3>
            <p>Separates DOM events, pointer state, visual feedback, and capability reporting.</p>
          </article>
        </div>
      </section>

      <section class="section platforms" aria-labelledby="platforms-title">
        <div class="section-heading">
          <p class="eyebrow">Documentation map</p>
          <h2 id="platforms-title">One site for browser now and native platforms later.</h2>
        </div>
        <div class="platform-list">
          <a href={browserDocs}>
            <span>Browser</span>
            <strong>Active docs</strong>
          </a>
          <a href={withBase('docs/macos/')}>
            <span>macOS</span>
            <strong>Placeholder</strong>
          </a>
          <a href={withBase('docs/windows/')}>
            <span>Windows</span>
            <strong>Placeholder</strong>
          </a>
          <a href={withBase('docs/linux/')}>
            <span>Linux</span>
            <strong>Placeholder</strong>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #ffffff;
    color: #101418;
    letter-spacing: 0;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: #ffffff;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 clamp(20px, 5vw, 72px);
    background: rgba(255, 255, 255, 0.88);
    border-bottom: 1px solid rgba(16, 20, 24, 0.08);
    backdrop-filter: blur(16px);
  }

  .brand {
    font-weight: 750;
    letter-spacing: 0;
  }

  .nav {
    display: flex;
    gap: 20px;
    color: #394653;
    font-size: 0.94rem;
  }

  .nav a:hover {
    color: #007f73;
  }

  .hero {
    position: relative;
    min-height: clamp(560px, 76vh, 740px);
    overflow: hidden;
    padding: 112px clamp(20px, 5vw, 72px) 68px;
    background:
      linear-gradient(90deg, #ffffff 0%, #ffffff 52%, rgba(255, 255, 255, 0.84) 70%, rgba(255, 255, 255, 0.2) 100%),
      #f8fafc;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: rgba(16, 20, 24, 0.08);
  }

  .scene {
    position: absolute;
    inset: 64px 0 0;
    display: grid;
    place-items: center;
    opacity: 0.9;
  }

  .browser-shell {
    width: min(1180px, 92vw);
    height: min(560px, 58vh);
    min-height: 430px;
    transform: translateX(min(34vw, 480px));
    overflow: hidden;
    border: 1px solid rgba(16, 20, 24, 0.12);
    border-radius: 8px;
    background: #101418;
    box-shadow: 0 26px 80px rgba(16, 20, 24, 0.18);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: #1f2932;
  }

  .browser-bar span {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #ff6b6b;
  }

  .browser-bar span:nth-child(2) {
    background: #f0b429;
  }

  .browser-bar span:nth-child(3) {
    background: #2fbf71;
  }

  .address {
    margin-left: 12px;
    width: min(360px, 40vw);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 6px 12px;
    color: #b8c6d1;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .workspace {
    position: relative;
    height: calc(100% - 42px);
    padding: clamp(22px, 4vw, 48px);
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      #101418;
    background-size: 32px 32px;
  }

  .panel {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .target-panel {
    left: 8%;
    top: 18%;
    width: min(420px, 42%);
    min-width: 300px;
    padding: 22px;
  }

  .trace-panel {
    right: 8%;
    bottom: 15%;
    width: min(360px, 34%);
    min-width: 260px;
    padding: 20px;
  }

  .label {
    color: #42d6bf;
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .field,
  .button-target {
    margin-top: 18px;
    border-radius: 6px;
    padding: 14px 16px;
    font-size: 0.96rem;
  }

  .field {
    border: 1px solid rgba(184, 198, 209, 0.34);
    color: #dce6ee;
  }

  .button-target {
    width: fit-content;
    background: #42d6bf;
    color: #072520;
    font-weight: 750;
  }

  .trace-panel ol {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: #dce6ee;
    font-size: 0.92rem;
  }

  .trace-panel li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .trace-panel li::before {
    content: "";
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: #f0b429;
  }

  .cursor {
    position: absolute;
    left: 42%;
    top: 56%;
    width: 22px;
    height: 22px;
    transform: rotate(-16deg);
    clip-path: polygon(0 0, 0 100%, 36% 72%, 56% 100%, 74% 91%, 55% 64%, 100% 64%);
    background: #ffffff;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.45));
    animation: cursor-move 7s ease-in-out infinite;
  }

  .path {
    position: absolute;
    height: 2px;
    transform-origin: left center;
    background: #42d6bf;
    opacity: 0.58;
  }

  .path-a {
    left: 32%;
    top: 58%;
    width: 18%;
    transform: rotate(-18deg);
  }

  .path-b {
    left: 50%;
    top: 51%;
    width: 17%;
    transform: rotate(22deg);
    background: #f0b429;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: min(680px, 100%);
    padding-top: clamp(20px, 7vh, 74px);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #007f73;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    letter-spacing: 0;
  }

  h1 {
    margin: 0;
    color: #101418;
    font-size: clamp(4rem, 11vw, 8rem);
    line-height: 0.9;
  }

  .lede {
    max-width: 540px;
    margin: 24px 0 0;
    color: #394653;
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.56;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 6px;
    padding: 0 18px;
    font-weight: 750;
  }

  .primary {
    background: #101418;
    color: #ffffff;
  }

  .secondary {
    border: 1px solid rgba(16, 20, 24, 0.16);
    background: rgba(255, 255, 255, 0.8);
    color: #101418;
  }

  .section {
    padding: clamp(54px, 8vw, 96px) clamp(20px, 5vw, 72px);
  }

  .intro {
    background: #ffffff;
  }

  .platforms {
    background: #f8fafc;
    border-top: 1px solid rgba(16, 20, 24, 0.08);
  }

  .section-heading {
    max-width: 760px;
  }

  h2 {
    margin: 0;
    color: #101418;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.05;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 34px;
  }

  .feature-grid article,
  .platform-list a {
    border: 1px solid rgba(16, 20, 24, 0.1);
    border-radius: 8px;
    background: #ffffff;
  }

  .feature-grid article {
    padding: 22px;
  }

  h3 {
    margin: 0;
    color: #101418;
    font-size: 1.02rem;
  }

  article p {
    margin: 12px 0 0;
    color: #52616f;
    line-height: 1.55;
  }

  .platform-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 34px;
  }

  .platform-list a {
    display: grid;
    gap: 10px;
    padding: 20px;
  }

  .platform-list a:hover {
    border-color: rgba(0, 127, 115, 0.45);
  }

  .platform-list span {
    color: #101418;
    font-weight: 800;
  }

  .platform-list strong {
    color: #52616f;
    font-size: 0.86rem;
  }

  @keyframes cursor-move {
    0%,
    100% {
      transform: translate(-20px, 12px) rotate(-16deg);
    }

    45% {
      transform: translate(104px, -48px) rotate(-16deg);
    }

    68% {
      transform: translate(226px, 40px) rotate(-16deg);
    }
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 640px;
      padding-top: 96px;
    }

    .scene {
      inset: 64px 0 0;
      opacity: 0.36;
    }

    .browser-shell {
      width: 820px;
      min-height: 400px;
      transform: translateX(220px) scale(0.86);
    }

    .hero-copy {
      padding-top: 36px;
    }

    .feature-grid,
    .platform-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .topbar {
      height: 58px;
      padding-inline: 18px;
    }

    .nav {
      gap: 14px;
      font-size: 0.88rem;
    }

    .hero {
      min-height: 620px;
      padding: 86px 18px 52px;
    }

    h1 {
      font-size: clamp(3.4rem, 20vw, 5.2rem);
    }

    .button {
      width: 100%;
    }

    .browser-shell {
      transform: translateX(230px) scale(0.78);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
