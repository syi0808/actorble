---
import ActorbleSymbol from '../components/ActorbleSymbol.astro'

const base = import.meta.env.BASE_URL
const withBase = (path: string) => `${base}${path.replace(/^\//, '')}`
const browserDocs = withBase('docs/browser/')
const examples = withBase('docs/browser/examples/')
const github = 'https://github.com/syi0808/actorble'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Actorble is an interface choreography engine for human-like UI scenarios across browser and future OS surfaces."
    />
    <title>Actorble | Interface choreography engine</title>
  </head>
  <body>
    <header class="topbar" aria-label="Primary navigation">
      <a class="brand" href={withBase('')} aria-label="Actorble home">
        <ActorbleSymbol class="brand-mark" />
        <span>Actorble</span>
      </a>
      <nav class="nav">
        <a href="#nested-demo">Demo</a>
        <a href={browserDocs}>Docs</a>
        <a href={github}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">Choreograph human-like UI scenarios.</h1>
            <p class="lede">
              Actorble runs visible interaction scenarios across interface surfaces,
              starting in the browser and designed for OS-level engines.
            </p>
            <div class="hero-actions">
              <button class="button primary" type="button" data-demo-run>
                Run nested demo
              </button>
              <a class="button secondary" href={browserDocs}>Read browser docs</a>
            </div>
          </div>

          <div class="demo-frame" id="nested-demo" data-landing-demo data-step="ready">
            <div class="demo-bar">
              <div class="window-dots" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <strong>Actorble nested demo</strong>
              <span id="landing-demo-status">Ready to run</span>
            </div>

            <div class="demo-stage">
              <section class="macos-desktop" data-demo-node="os" aria-label="macOS style demo desktop">
                <div class="mac-menu">
                  <div class="mac-menu-left">
                    <span class="apple-dot" aria-hidden="true"></span>
                    <span>Actorble</span>
                    <span>File</span>
                    <span>Edit</span>
                    <span>Window</span>
                  </div>
                  <div class="mac-menu-right">
                    <span>Wi-Fi</span>
                    <span>Sat 9:41</span>
                  </div>
                </div>

                <div class="desktop-ribbon" aria-hidden="true">
                  <ActorbleSymbol class="desktop-ribbon-symbol" variant="motion" />
                </div>

                <section class="actorble-window" data-demo-node="host" aria-label="Actorble app window">
                  <div class="mac-window-bar">
                    <div class="window-dots" aria-hidden="true">
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <strong>Actorble</strong>
                    <span id="landing-host-status">Scenario is waiting</span>
                  </div>

                  <div class="actorble-body">
                    <div class="actorble-heading">
                      <h2>Run an interface scenario across surfaces.</h2>
                      <p>
                        The host opens Chrome, then the browser scenario starts another
                        Actorble run inside the page.
                      </p>
                    </div>

                    <button
                      class="host-run"
                      type="button"
                      data-testid="landing-host-run-browser"
                    >
                      Run browser scenario
                    </button>

                    <div class="progress-rail" aria-label="Demo progress">
                      <div class="progress-item" data-progress-step="os">
                        <span></span>
                        <p>Open from macOS Dock</p>
                      </div>
                      <div class="progress-item" data-progress-step="host">
                        <span></span>
                        <p>Actorble host starts</p>
                      </div>
                      <div class="progress-item" data-progress-step="browser">
                        <span></span>
                        <p>Chrome receives control</p>
                      </div>
                      <div class="progress-item" data-progress-step="project">
                        <span></span>
                        <p>Browser project is created</p>
                      </div>
                      <div class="progress-item" data-progress-step="nested">
                        <span></span>
                        <p>Nested browser Actorble runs</p>
                      </div>
                    </div>
                  </div>
                </section>

                <section class="chrome-window" data-demo-node="browser" aria-label="Chrome style browser window">
                  <div class="chrome-tab-strip">
                    <div class="window-dots" aria-hidden="true">
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <div class="chrome-tab active">
                      <span class="chrome-favicon" aria-hidden="true"></span>
                      <span>Actorble project</span>
                    </div>
                    <div class="chrome-tab muted">Scenario console</div>
                  </div>
                  <div class="chrome-toolbar">
                    <div class="chrome-controls" aria-hidden="true">
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <div class="chrome-address">actorble.local/demo/nested</div>
                    <div class="chrome-profile" aria-hidden="true">A</div>
                  </div>

                  <div class="browser-page">
                    <div class="page-heading">
                      <h2>Browser project setup</h2>
                      <p>Actorble drives this page with real browser actions.</p>
                    </div>

                    <div class="form-grid">
                      <label class="field">
                        <span>Project name</span>
                        <input
                          id="landing-inner-project-name"
                          data-testid="landing-inner-project-name"
                          autocomplete="off"
                          placeholder="Release review"
                        />
                      </label>
                      <button
                        class="create-button"
                        type="button"
                        data-testid="landing-inner-create-project"
                      >
                        Create project
                      </button>
                    </div>

                    <div class="workflow-grid">
                      <button
                        class="workflow-card"
                        type="button"
                        data-testid="landing-inner-checklist"
                        data-state="idle"
                        disabled
                      >
                        <span>Collect interface state</span>
                        <em>Waiting for project</em>
                      </button>
                      <label class="field compact">
                        <span>Operator email</span>
                        <input
                          id="landing-operator-email"
                          data-testid="landing-operator-email"
                          autocomplete="off"
                          placeholder="ops@actorble.dev"
                          disabled
                        />
                      </label>
                    </div>

                    <div class="browser-actions">
                      <button
                        type="button"
                        data-testid="landing-invite-operator"
                        disabled
                      >
                        Invite operator
                      </button>
                      <button
                        type="button"
                        data-testid="landing-inner-run-nested"
                        disabled
                      >
                        Run nested Actorble
                      </button>
                      <button
                        type="button"
                        data-testid="landing-review-ready"
                        disabled
                      >
                        Review ready
                      </button>
                    </div>

                    <div class="browser-status-grid">
                      <p
                        class="inner-status"
                        id="landing-inner-status"
                        data-testid="landing-inner-status"
                        data-state="idle"
                        aria-live="polite"
                      >
                        Waiting for browser scenario
                      </p>
                      <p
                        class="nested-status"
                        id="landing-nested-runtime"
                        data-testid="landing-nested-runtime"
                        data-state="idle"
                        aria-live="polite"
                      >
                        Nested Actorble is ready inside Chrome
                      </p>
                    </div>
                  </div>
                </section>

                <div class="dock" aria-label="macOS Dock">
                  <button
                    class="dock-icon actorble"
                    type="button"
                    data-testid="landing-os-launch"
                    aria-label="Launch Actorble"
                  >
                    <ActorbleSymbol class="dock-mark" />
                  </button>
                  <span class="dock-icon finder" aria-hidden="true"></span>
                  <span class="dock-icon chrome" aria-hidden="true"></span>
                  <span class="dock-icon notes" aria-hidden="true"></span>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>

      <section class="section surfaces" aria-labelledby="surfaces-title">
        <div class="section-heading">
          <h2 id="surfaces-title">Start in the browser. Keep the model ready for OS engines.</h2>
          <p>
            Actorble treats interaction as a scenario, not a one-off command. The browser
            package is active now. Native platform engines can keep the same orchestration
            shape while swapping the platform layer.
          </p>
        </div>
        <div class="surface-grid">
          <article class="surface-card active">
            <h3>Browser</h3>
            <p>Available today with target resolution, synthetic input, visual feedback, and run records.</p>
          </article>
          <article class="surface-card">
            <h3>macOS</h3>
            <p>Planned engine for OS-level surfaces and native application control.</p>
          </article>
          <article class="surface-card">
            <h3>Windows</h3>
            <p>Planned engine for desktop workflows that need the same scenario contract.</p>
          </article>
          <article class="surface-card">
            <h3>Linux</h3>
            <p>Planned engine for automation surfaces outside the browser sandbox.</p>
          </article>
        </div>
      </section>

      <section class="section model" aria-labelledby="model-title">
        <div class="section-heading">
          <h2 id="model-title">Every action moves through a visible lifecycle.</h2>
        </div>
        <div class="model-grid">
          <article>
            <h3>Scenario runner</h3>
            <p>Runs ordered steps with timeout, pacing, pause, resume, and stop controls.</p>
          </article>
          <article>
            <h3>Action orchestrator</h3>
            <p>Turns click and typeInto into resolve, geometry, preflight, perform, wait, and cleanup.</p>
          </article>
          <article>
            <h3>Target engines</h3>
            <p>Resolve targets, compute geometry, check interactability, and report useful context.</p>
          </article>
          <article>
            <h3>Observation</h3>
            <p>Waits for interface settlement and keeps warnings, capability, and fidelity data close.</p>
          </article>
        </div>
      </section>

      <section class="section diagnostics" aria-labelledby="diagnostics-title">
        <div class="diagnostics-grid">
          <div class="section-heading">
            <h2 id="diagnostics-title">The page shows what the engine is doing.</h2>
            <p>
              Visitors should see a real interface sequence before they read an API contract.
              The landing page now makes the OS surface, host app, browser window, and nested
              run visible in one flow.
            </p>
          </div>
          <div class="visual-panel" aria-label="Visual scenario summary">
            <div class="visual-step active">
              <span></span>
              <p>macOS opens Actorble</p>
            </div>
            <div class="visual-step">
              <span></span>
              <p>Actorble opens Chrome</p>
            </div>
            <div class="visual-step">
              <span></span>
              <p>Chrome runs another Actorble scenario</p>
            </div>
            <div class="visual-step">
              <span></span>
              <p>The browser page reaches a review-ready state</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section final-cta" aria-labelledby="cta-title">
        <h2 id="cta-title">Run a scenario you can watch from start to finish.</h2>
        <div class="hero-actions">
          <button class="button primary" type="button" data-demo-run>
            Run nested demo
          </button>
          <a class="button secondary" href={examples}>See examples</a>
          <a class="button ghost" href={github}>Open GitHub</a>
        </div>
      </section>
    </main>
  </body>
</html>

<script>
  import {
    createActorble,
    testId,
    type Actorble,
    type Scenario,
    type VisualFeedbackPreset,
  } from '@actorble/browser-source'

  type DemoStep = 'ready' | 'os' | 'host' | 'inner' | 'complete' | 'failed'

  const demoRoot = document.querySelector<HTMLElement>('[data-landing-demo]')

  if (demoRoot) {
    const activeDemoRoot = demoRoot
    const runButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo-run]'))
    const statusOutput = document.getElementById('landing-demo-status')
    const hostStatus = document.getElementById('landing-host-status')
    const innerProjectInput = document.getElementById(
      'landing-inner-project-name',
    ) as HTMLInputElement | null
    const operatorEmailInput = document.getElementById(
      'landing-operator-email',
    ) as HTMLInputElement | null
    const innerStatus = document.getElementById('landing-inner-status') as HTMLElement | null
    const nestedStatus = document.getElementById('landing-nested-runtime') as HTMLElement | null
    const osLaunch = document.querySelector<HTMLButtonElement>('[data-testid="landing-os-launch"]')
    const hostRun = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-host-run-browser"]',
    )
    const createButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-inner-create-project"]',
    )
    const checklistButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-inner-checklist"]',
    )
    const inviteButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-invite-operator"]',
    )
    const nestedRunButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-inner-run-nested"]',
    )
    const reviewButton = document.querySelector<HTMLButtonElement>(
      '[data-testid="landing-review-ready"]',
    )
    const progressItems = Array.from(
      document.querySelectorAll<HTMLElement>('[data-progress-step]'),
    )
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const canAutoPlay = !reduceMotion && window.matchMedia('(min-width: 900px)').matches

    let running = false
    let runCount = 0
    let nestedTimer: number | undefined

    osLaunch?.addEventListener('click', () => {
      setDemoStep('host', 'Actorble app opened from the Dock')
      setHostStatus('Actorble is ready to open Chrome')
      setProgressStep('host')
    })

    hostRun?.addEventListener('click', () => {
      setDemoStep('inner', 'Chrome is ready for the browser scenario')
      setHostStatus('Chrome is under Actorble control')
      setProgressStep('browser')
    })

    createButton?.addEventListener('click', () => {
      createProject()
    })

    checklistButton?.addEventListener('click', () => {
      collectInterfaceState()
    })

    inviteButton?.addEventListener('click', () => {
      inviteOperator()
    })

    nestedRunButton?.addEventListener('click', () => {
      runNestedActorbleInsideBrowser()
    })

    reviewButton?.addEventListener('click', () => {
      markReviewReady()
    })

    for (const button of runButtons) {
      button.addEventListener('click', () => {
        void runNestedDemo()
      })
    }

    resetDemo()

    if (canAutoPlay) {
      window.setTimeout(() => {
        void runNestedDemo()
      }, 900)
    }

    async function runNestedDemo() {
      if (running) {
        return
      }

      running = true
      runCount += 1
      setRunButtonsDisabled(true)
      resetDemo()

      const startedAt = performance.now()

      try {
        setDemoStep('os', 'Moving to the macOS Dock')
        setProgressStep('os')

        if (isCompactDemo()) {
          osLaunch?.click()
        } else {
          const outer = createDemoActorble('quiet')

          try {
            await outer.click(testId('landing-os-launch'), createPreviewClickOptions())
          } finally {
            outer.destroy()
          }
        }

        await wait(760)

        setDemoStep('host', 'Actorble is opening Chrome')

        if (isCompactDemo()) {
          hostRun?.click()
        } else {
          const host = createDemoActorble('quiet')

          try {
            await host.click(testId('landing-host-run-browser'), createPreviewClickOptions())
          } finally {
            host.destroy()
          }
        }

        await wait(820)

        setDemoStep('inner', 'Browser scenario is running')
        const inner = createDemoActorble('debug')

        try {
          await inner.run(buildInnerScenario(runCount), {
            timeout: 32000,
            pacing: { betweenSteps: 560 },
          })
        } finally {
          await wait(420)
          inner.destroy()
        }

        const elapsed = ((performance.now() - startedAt) / 1000).toFixed(1)
        setDemoStep('complete', `Nested demo complete in ${elapsed}s`)
        setProgressStep('complete')
      } catch (error) {
        const message = error instanceof Error ? error.message : String(error)
        setDemoStep('failed', `Demo stopped: ${message}`)
      } finally {
        setRunButtonsDisabled(false)
        running = false
      }
    }

    function createDemoActorble(preset: VisualFeedbackPreset): Actorble {
      return createActorble({
        mode: 'interactive',
        debug: true,
        visual: {
          preset,
          cursorScale: preset === 'debug' ? 1.18 : 1.08,
          textVisibility: 'plain',
        },
      })
    }

    function createPreviewClickOptions() {
      return {
        ...revealNearest(),
        motion: { kind: 'ease' as const, easing: 'ease-in-out' as const, duration: 720 },
        force: true,
        pressDwell: 160,
        timeout: 3600,
      }
    }

    function buildInnerScenario(index: number): Scenario {
      const projectName = `Release review ${index}`
      const operatorEmail = `ops+run${index}@actorble.dev`
      const typeOptions = {
        ...revealNearest(),
        delay: 74,
        focusStrategy: 'programmatic' as const,
        afterFocusDelay: 130,
        timeout: 7200,
      }
      const clickOptions = {
        ...revealNearest(),
        motion: { kind: 'ease' as const, easing: 'ease-in-out' as const, duration: 680 },
        pressDwell: 150,
        timeout: 4200,
      }

      return {
        id: 'landing-nested-demo',
        name: 'Landing nested demo',
        steps: [
          {
            action: 'typeInto',
            target: testId('landing-inner-project-name'),
            input: projectName,
            options: typeOptions,
          },
          {
            action: 'delay',
            duration: 780,
            reason: 'Let the typed project name settle',
          },
          {
            action: 'click',
            target: testId('landing-inner-create-project'),
            options: clickOptions,
          },
          {
            action: 'waitFor',
            input: {
              kind: 'custom',
              predicate: () => innerStatus?.dataset.state === 'created',
            },
            options: { timeout: 3000 },
          },
          {
            action: 'delay',
            duration: 720,
            reason: 'Show the created project state',
          },
          {
            action: 'click',
            target: testId('landing-inner-checklist'),
            options: clickOptions,
          },
          {
            action: 'waitFor',
            input: {
              kind: 'custom',
              predicate: () => checklistButton?.dataset.state === 'collected',
            },
            options: { timeout: 3000 },
          },
          {
            action: 'delay',
            duration: 680,
            reason: 'Keep the checklist result visible',
          },
          {
            action: 'typeInto',
            target: testId('landing-operator-email'),
            input: operatorEmail,
            options: typeOptions,
          },
          {
            action: 'delay',
            duration: 640,
            reason: 'Show the operator handoff',
          },
          {
            action: 'click',
            target: testId('landing-invite-operator'),
            options: clickOptions,
          },
          {
            action: 'waitFor',
            input: {
              kind: 'custom',
              predicate: () => innerStatus?.dataset.state === 'invited',
            },
            options: { timeout: 3000 },
          },
          {
            action: 'delay',
            duration: 720,
            reason: 'Prepare the nested run',
          },
          {
            action: 'click',
            target: testId('landing-inner-run-nested'),
            options: clickOptions,
          },
          {
            action: 'waitFor',
            input: {
              kind: 'custom',
              predicate: () => nestedStatus?.dataset.state === 'complete',
            },
            options: { timeout: 3600 },
          },
          {
            action: 'delay',
            duration: 760,
            reason: 'Hold the nested completion state',
          },
          {
            action: 'click',
            target: testId('landing-review-ready'),
            options: clickOptions,
          },
          {
            action: 'waitFor',
            input: {
              kind: 'custom',
              predicate: () => innerStatus?.dataset.state === 'review',
            },
            options: { timeout: 3000 },
          },
        ],
      }
    }

    function revealNearest() {
      return {
        block: 'nearest' as ScrollLogicalPosition,
        inline: 'nearest' as ScrollLogicalPosition,
      }
    }

    function isCompactDemo(): boolean {
      return window.matchMedia('(max-width: 899px)').matches
    }

    function resetDemo() {
      if (nestedTimer !== undefined) {
        window.clearTimeout(nestedTimer)
        nestedTimer = undefined
      }

      setDemoStep('ready', 'Ready to run')
      setHostStatus('Scenario is waiting')
      setProgressStep('ready')

      if (innerProjectInput) {
        innerProjectInput.value = ''
      }

      if (operatorEmailInput) {
        operatorEmailInput.value = ''
        operatorEmailInput.disabled = true
      }

      if (checklistButton) {
        checklistButton.disabled = true
        checklistButton.dataset.state = 'idle'
        checklistButton.setAttribute('aria-pressed', 'false')
        const stateText = checklistButton.querySelector('em')
        if (stateText) {
          stateText.textContent = 'Waiting for project'
        }
      }

      if (inviteButton) {
        inviteButton.disabled = true
      }

      if (nestedRunButton) {
        nestedRunButton.disabled = true
      }

      if (reviewButton) {
        reviewButton.disabled = true
      }

      if (innerStatus) {
        innerStatus.dataset.state = 'idle'
        innerStatus.textContent = 'Waiting for browser scenario'
      }

      if (nestedStatus) {
        nestedStatus.dataset.state = 'idle'
        nestedStatus.textContent = 'Nested Actorble is ready inside Chrome'
      }
    }

    function createProject() {
      const projectName =
        innerProjectInput instanceof HTMLInputElement && innerProjectInput.value.trim().length > 0
          ? innerProjectInput.value.trim()
          : 'Release review'

      if (innerStatus) {
        innerStatus.dataset.state = 'created'
        innerStatus.textContent = `${projectName} is ready for interface capture`
      }

      if (checklistButton) {
        checklistButton.disabled = false
        checklistButton.dataset.state = 'ready'
        const stateText = checklistButton.querySelector('em')
        if (stateText) {
          stateText.textContent = 'Ready to collect'
        }
      }

      if (operatorEmailInput) {
        operatorEmailInput.disabled = false
      }

      setProgressStep('project')
    }

    function collectInterfaceState() {
      if (checklistButton) {
        checklistButton.dataset.state = 'collected'
        checklistButton.setAttribute('aria-pressed', 'true')
        const stateText = checklistButton.querySelector('em')
        if (stateText) {
          stateText.textContent = 'Interface state collected'
        }
      }

      if (innerStatus) {
        innerStatus.dataset.state = 'collected'
        innerStatus.textContent = 'Interface state collected from the browser page'
      }

      if (inviteButton) {
        inviteButton.disabled = false
      }
    }

    function inviteOperator() {
      const email =
        operatorEmailInput instanceof HTMLInputElement && operatorEmailInput.value.trim().length > 0
          ? operatorEmailInput.value.trim()
          : 'ops@actorble.dev'

      if (innerStatus) {
        innerStatus.dataset.state = 'invited'
        innerStatus.textContent = `${email} was invited into the run`
      }

      if (nestedRunButton) {
        nestedRunButton.disabled = false
      }
    }

    function runNestedActorbleInsideBrowser() {
      if (nestedRunButton) {
        nestedRunButton.disabled = true
      }

      if (nestedStatus) {
        nestedStatus.dataset.state = 'running'
        nestedStatus.textContent = 'Nested browser Actorble is running inside Chrome'
      }

      setProgressStep('nested')

      nestedTimer = window.setTimeout(() => {
        nestedTimer = undefined

        if (nestedStatus) {
          nestedStatus.dataset.state = 'complete'
          nestedStatus.textContent = 'Nested browser Actorble finished its pass'
        }

        if (reviewButton) {
          reviewButton.disabled = false
        }
      }, 940)
    }

    function markReviewReady() {
      if (innerStatus) {
        innerStatus.dataset.state = 'review'
        innerStatus.textContent = 'Review-ready state reached inside the browser'
      }

      setProgressStep('complete')
    }

    function setDemoStep(step: DemoStep, label: string): void {
      activeDemoRoot.dataset.step = step

      if (statusOutput) {
        statusOutput.textContent = label
      }
    }

    function setHostStatus(label: string): void {
      if (hostStatus) {
        hostStatus.textContent = label
      }
    }

    function setProgressStep(step: string): void {
      const order = ['os', 'host', 'browser', 'project', 'nested', 'complete']
      const activeIndex = order.indexOf(step)

      for (const item of progressItems) {
        const itemStep = item.dataset.progressStep ?? ''
        const itemIndex = order.indexOf(itemStep)

        if (activeIndex < 0 || itemIndex < 0) {
          item.dataset.state = 'idle'
        } else if (itemIndex < activeIndex) {
          item.dataset.state = 'done'
        } else if (itemIndex === activeIndex) {
          item.dataset.state = 'active'
        } else {
          item.dataset.state = 'idle'
        }
      }
    }

    function setRunButtonsDisabled(disabled: boolean): void {
      for (const button of runButtons) {
        button.disabled = disabled
      }
    }

    function wait(duration: number): Promise<void> {
      return new Promise((resolve) => {
        window.setTimeout(resolve, duration)
      })
    }
  }
