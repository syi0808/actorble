{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "ignorePatterns": [".output/**", ".wxt/**", "coverage/**"],
  "rules": {
    "no-unused-vars": "off",
    "no-useless-escape": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  }
}
