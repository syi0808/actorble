{
  "name": "@actorble/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension GUI shell for Actorble.",
  "keywords": [
    "actorble",
    "browser-extension",
    "wxt"
  ],
  "license": "Apache-2.0 OR MIT",
  "author": "Yein Sung",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@actorble/browser": "file:../browser",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lucide": "^1.21.0",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@11.23.0"
}
