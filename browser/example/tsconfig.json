{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"]
  },
  "include": [
    "shared/**/*.ts",
    "github-explorer/src/**/*.ts",
    "form-filling/src/**/*.ts",
    "appointment-scheduler/src/**/*.ts",
    "web-search/src/**/*.ts",
    "selection-pointer-sequence/src/**/*.ts"
  ]
}
